#!/usr/bin/env python3
"""
ivanti-amnesia - diagnose and recover Ivanti Secure Access when its embedded
SAML login gets stuck on the Shibboleth "Unable to complete request / you waited
an extended period of time" page.

Safety model
    * refuses to run as root
    * only ever deletes paths on an explicit allowlist: entries under
      ~/Library/{HTTPStorages,Caches,WebKit} whose path contains the app's
      bundle id, plus keys in the app's own preference domain
    * every byte it removes is copied into a timestamped backup first
    * --dry-run prints the exact plan and changes nothing
    * quits the app via AppleScript/SIGTERM only, never SIGKILL (a SIGKILL
      during a cookie-jar flush is one of the ways this breaks in the first
      place)
    * cookie values are never printed - only length and a short digest
"""

import argparse
import datetime as dt
import hashlib
import json
import os
import plistlib
import shutil
import signal
import sqlite3
import struct
import subprocess
import sys
import tempfile
import time
from pathlib import Path

BUNDLE = "net.pulsesecure.Pulse-Secure"
APP = Path("/Applications/Ivanti Secure Access.app")
APP_BIN = APP / "Contents/MacOS/Ivanti Secure Access"
HELPER_PATTERNS = ("Plugins/JamUI/WebLoginService.app", "Plugins/JamUI/cefBrowser")

# Resolved: every target is compared and stored as a realpath, so HOME must be
# one too, or a symlinked home directory breaks backup path arithmetic.
HOME = Path(os.path.realpath(Path.home()))
LIB = HOME / "Library"
JAR = LIB / "HTTPStorages" / (BUNDLE + ".binarycookies")
HTTP_DIR = LIB / "HTTPStorages" / BUNDLE
CACHE_DIR = LIB / "Caches" / BUNDLE
WEBKIT_DIR = LIB / "WebKit" / BUNDLE
PREFS = LIB / "Preferences" / (BUNDLE + ".plist")

STATE = LIB / "Application Support/ivanti-amnesia"
BACKUPS = STATE / "backups"
CAPTURES = STATE / "captures"

# Cookies preserved by `fix --level session`: Duo remembered-device material.
# Dropping these costs you an extra Duo approval on the next login.
KEEP_DOMAIN_SUFFIXES = ("duosecurity.com",)

# Preference keys that grow without bound, one per attempted SAML Single Logout.
PRUNE_KEY_MARKERS = ("SAMLRequest=",)

CAPTURE_WARNING = """\
This directory contains UNREDACTED authentication material copied straight off
the machine: the live cookie jar (session and SSO cookies, values in the clear),
the app preferences, and the HTTP cache holding one-time SSO callback URLs.

Anyone who gets a copy while these cookies are still valid may be able to resume
your VPN and SSO session. Treat it exactly like a password.

  * Do NOT attach it to a bug report, GitHub issue, ticket, chat or email.
  * Do NOT put it in cloud storage or anywhere that syncs off the machine.
  * Delete it once you are done:  rm -rf %s

To share findings safely, quote the output of `ivanti-amnesia status` instead --
that redacts every cookie value down to a length and an 8-character digest.
"""

MAC_EPOCH = 978307200.0
COOKIE_MAGIC = b"cook"
FOOTER_MAGIC = b"\x07\x17\x20\x05"
PAGE_MAGIC = b"\x00\x00\x01\x00"

BOLD, DIM, RED, YEL, GRN, OFF = "\033[1m", "\033[2m", "\033[31m", "\033[33m", "\033[32m", "\033[0m"
if not sys.stdout.isatty():
    BOLD = DIM = RED = YEL = GRN = OFF = ""


def die(msg, code=1):
    print("%serror:%s %s" % (RED, OFF, msg), file=sys.stderr)
    sys.exit(code)


def warn(msg):
    print("%swarning:%s %s" % (YEL, OFF, msg), file=sys.stderr)


# --------------------------------------------------------------------------
# binarycookies codec
#
# Layout, verified byte-for-byte against this machine's jar (see selftest):
#   'cook' | page_count(BE u32) | page_size[n](BE u32) | pages | checksum(BE u32)
#   | 07 17 20 05 | meta_len(BE u32) | meta (binary plist)
# page: 00 00 01 00 | cookie_count(LE u32) | cookie_offset[n](LE u32)
#       | 00 00 00 00 | cookie records
# The checksum is the sum of every 4th byte of every page.
# --------------------------------------------------------------------------


def jar_load(data):
    """Return (pages, meta) where pages is a list of lists of raw cookie records."""
    if data[:4] != COOKIE_MAGIC:
        raise ValueError("not a binarycookies file")
    n = struct.unpack(">I", data[4:8])[0]
    if n > 100000:
        raise ValueError("implausible page count %d" % n)
    sizes = struct.unpack(">%dI" % n, data[8 : 8 + 4 * n])
    off = 8 + 4 * n
    pages = []
    for size in sizes:
        page = data[off : off + size]
        off += size
        if len(page) != size:
            raise ValueError("truncated page")
        if page[:4] != PAGE_MAGIC:
            raise ValueError("bad page header %s" % page[:4].hex())
        count = struct.unpack("<I", page[4:8])[0]
        offsets = struct.unpack("<%dI" % count, page[8 : 8 + 4 * count])
        records = []
        for co in offsets:
            length = struct.unpack("<I", page[co : co + 4])[0]
            rec = page[co : co + length]
            if len(rec) != length:
                raise ValueError("truncated cookie record")
            records.append(rec)
        pages.append(records)
    trailer = data[off:]
    if len(trailer) < 12 or trailer[4:8] != FOOTER_MAGIC:
        raise ValueError("bad trailer")
    meta_len = struct.unpack(">I", trailer[8:12])[0]
    meta = trailer[12:]
    if len(meta) != meta_len:
        raise ValueError("trailer length mismatch")
    return pages, meta


def _jar_page(records):
    base = 8 + 4 * len(records) + 4
    offsets, body = [], b""
    for rec in records:
        offsets.append(base + len(body))
        body += rec
    return (
        PAGE_MAGIC
        + struct.pack("<I", len(records))
        + b"".join(struct.pack("<I", o) for o in offsets)
        + b"\x00\x00\x00\x00"
        + body
    )


def jar_dump(pages, meta):
    blobs = [_jar_page(recs) for recs in pages if recs]
    checksum = 0
    for blob in blobs:
        for i in range(0, len(blob), 4):
            checksum += blob[i]
    return (
        COOKIE_MAGIC
        + struct.pack(">I", len(blobs))
        + b"".join(struct.pack(">I", len(b)) for b in blobs)
        + b"".join(blobs)
        + struct.pack(">I", checksum)
        + FOOTER_MAGIC
        + struct.pack(">I", len(meta))
        + meta
    )


def cookie_fields(rec):
    length = struct.unpack("<I", rec[0:4])[0]
    flags = struct.unpack("<I", rec[8:12])[0]
    d_off, n_off, p_off, v_off = struct.unpack("<4I", rec[16:32])
    expires, created = struct.unpack("<dd", rec[40:56])

    def text(off):
        if not 0 < off < length:
            return ""
        end = rec.index(b"\x00", off)
        return rec[off:end].decode("utf-8", "replace")

    return {
        "domain": text(d_off),
        "name": text(n_off),
        "path": text(p_off),
        "value": text(v_off),
        "expires": expires,
        "created": created,
        "secure": bool(flags & 1),
        "httponly": bool(flags & 4),
    }


def jar_selftest(data):
    """True if this file survives a parse/serialise round trip unchanged."""
    try:
        pages, meta = jar_load(data)
        return jar_dump(pages, meta) == data
    except Exception:
        return False


def keep_cookie(field):
    domain = field["domain"].lstrip(".").lower()
    return any(domain == s or domain.endswith("." + s) for s in KEEP_DOMAIN_SUFFIXES)


def redact(value):
    if not value:
        return "len=0"
    digest = hashlib.sha256(value.encode("utf-8", "replace")).hexdigest()[:8]
    return "len=%d %s" % (len(value), digest)


def shell_quote(path):
    """A copy-pasteable path: $HOME-relative and quoted, since it contains spaces."""
    return '"%s"' % str(path).replace(str(HOME), "$HOME")


def mac_time(value):
    if not value:
        return "session"
    try:
        return dt.datetime.fromtimestamp(value + MAC_EPOCH).strftime("%Y-%m-%d")
    except (ValueError, OverflowError, OSError):
        return "?"


# --------------------------------------------------------------------------
# path safety
# --------------------------------------------------------------------------

FORBIDDEN_PARTS = {"Safari", "com.apple.Safari", "Keychains", "Containers"}


def safe_target(path):
    """Resolve `path` and refuse anything outside the allowlist."""
    real = Path(os.path.realpath(path))
    lib = Path(os.path.realpath(LIB))
    if not str(real).startswith(str(lib) + os.sep):
        die("refusing to touch %s (outside %s)" % (real, lib))
    if not any(BUNDLE in part for part in real.parts):
        die("refusing to touch %s (not an Ivanti path)" % real)
    bad = FORBIDDEN_PARTS.intersection(real.parts)
    if bad:
        die("refusing to touch %s (contains %s)" % (real, ", ".join(sorted(bad))))
    return real


def dir_size(path):
    total = 0
    for root, _dirs, files in os.walk(path, onerror=lambda e: None):
        for name in files:
            try:
                total += os.lstat(os.path.join(root, name)).st_size
            except OSError:
                pass
    return total


def human(size):
    for unit in ("B", "K", "M", "G"):
        if size < 1024 or unit == "G":
            return "%.0f%s" % (size, unit) if unit != "B" else "%dB" % size
        size /= 1024.0


# --------------------------------------------------------------------------
# process control
# --------------------------------------------------------------------------


OWN_PROCESS_NAMES = ("Ivanti Secure Access", "WebLoginService", "cefBrowser")


def is_ours(pid):
    """pgrep -f matches command lines; confirm the executable before signalling."""
    try:
        comm = subprocess.run(
            ["ps", "-o", "comm=", "-p", str(pid)], capture_output=True, text=True, timeout=10
        ).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return False
    return comm.startswith(str(APP)) and any(n in comm for n in OWN_PROCESS_NAMES)


def pids_for(pattern):
    try:
        out = subprocess.run(
            ["pgrep", "-u", str(os.getuid()), "-f", pattern],
            capture_output=True, text=True, timeout=10,
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    return [int(p) for p in out.split()
            if p.isdigit() and int(p) != os.getpid() and is_ours(int(p))]


def app_pids():
    found = list(pids_for(str(APP_BIN)))
    for pattern in HELPER_PATTERNS:
        for pid in pids_for(pattern):
            if pid not in found:
                found.append(pid)
    return found


def pid_started(pid):
    try:
        out = subprocess.run(
            ["ps", "-o", "lstart=", "-p", str(pid)], capture_output=True, text=True, timeout=10
        ).stdout.strip()
        return out or "?"
    except (OSError, subprocess.SubprocessError):
        return "?"


def pid_elapsed(pid):
    try:
        out = subprocess.run(
            ["ps", "-o", "etime=", "-p", str(pid)], capture_output=True, text=True, timeout=10
        ).stdout.strip()
        return out or "?"
    except (OSError, subprocess.SubprocessError):
        return "?"


def quit_app(dry):
    pids = app_pids()
    if not pids:
        print("  app is not running")
        return True
    print("  quitting Ivanti Secure Access (pids %s)" % ", ".join(map(str, pids)))
    if dry:
        print("  %s[dry-run]%s would send 'quit', then SIGTERM if needed" % (DIM, OFF))
        return True
    subprocess.run(
        ["osascript", "-e", 'tell application "Ivanti Secure Access" to quit'],
        capture_output=True, timeout=30,
    )
    for _ in range(20):
        if not app_pids():
            print("  %sapp exited cleanly%s" % (GRN, OFF))
            return True
        time.sleep(0.5)
    for pid in app_pids():
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    for _ in range(20):
        if not app_pids():
            print("  %sapp exited after SIGTERM%s" % (GRN, OFF))
            return True
        time.sleep(0.5)
    # Deliberately no SIGKILL: killing mid-flush is what leaves torn cookie jars.
    return False


def launch_app(dry):
    if dry:
        print("  %s[dry-run]%s would relaunch %s" % (DIM, OFF, APP.name))
        return
    subprocess.run(["open", "-a", str(APP)], capture_output=True, timeout=30)
    print("  relaunched %s" % APP.name)


def gateway_hosts():
    """Gateway hostnames the client knows about, from cookies and window prefs."""
    hosts = set()
    try:
        pages, _ = jar_load(JAR.read_bytes())
        for recs in pages:
            for rec in recs:
                field = cookie_fields(rec)
                domain = field["domain"].lstrip(".")
                if (domain.startswith("vpn.")
                        or "/dana-na/" in field["path"]
                        or field["name"].startswith("DS")):
                    hosts.add(domain)
    except Exception:
        pass
    return sorted(hosts)


def tunnel_established(hosts):
    """Best-effort: is there a live TCP session to a known gateway on :443?"""
    if not hosts:
        return []
    addrs = set()
    for host in hosts:
        try:
            out = subprocess.run(
                ["dscacheutil", "-q", "host", "-a", "name", host],
                capture_output=True, text=True, timeout=10,
            ).stdout
        except (OSError, subprocess.SubprocessError):
            continue
        for line in out.splitlines():
            if line.startswith("ip_address:"):
                addrs.add(line.split(":", 1)[1].strip())
    if not addrs:
        return []
    try:
        net = subprocess.run(
            ["netstat", "-an", "-p", "tcp"], capture_output=True, text=True, timeout=20
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    live = []
    for line in net.splitlines():
        if "ESTABLISHED" not in line:
            continue
        for addr in addrs:
            if ("%s.443" % addr) in line:
                live.append(addr)
    return sorted(set(live))


def private_relay_active():
    """Best effort. Returns True/False/None(unknown)."""
    try:
        raw = subprocess.run(
            ["defaults", "export", "com.apple.networkserviceproxy", "-"],
            capture_output=True, timeout=10,
        ).stdout
        blob = plistlib.loads(raw).get("NSPServiceStatusManagerInfo")
        if not isinstance(blob, (bytes, bytearray)):
            return None
        inner = plistlib.loads(bytes(blob))
        for obj in inner.get("$objects", []):
            if isinstance(obj, dict) and "PrivacyProxyServiceStatus" in obj:
                return bool(obj["PrivacyProxyServiceStatus"])
    except Exception:
        return None
    return None


# --------------------------------------------------------------------------
# preferences
# --------------------------------------------------------------------------


def prefs_export():
    try:
        raw = subprocess.run(
            ["defaults", "export", BUNDLE, "-"], capture_output=True, timeout=30
        ).stdout
        return plistlib.loads(raw) if raw else {}
    except Exception:
        return {}


def prunable_pref_keys(prefs):
    return sorted(
        k for k in prefs
        if k.startswith("NSWindow Frame ") and any(m in k for m in PRUNE_KEY_MARKERS)
    )


# --------------------------------------------------------------------------
# cache inspection
# --------------------------------------------------------------------------


def cache_stats():
    db = CACHE_DIR / "Cache.db"
    if not db.exists():
        return None
    with tempfile.TemporaryDirectory() as tmp:
        for suffix in ("", "-wal", "-shm"):
            src = Path(str(db) + suffix)
            if src.exists():
                try:
                    shutil.copy2(src, Path(tmp) / src.name)
                except OSError:
                    pass
        copy = Path(tmp) / db.name
        if not copy.exists():
            return None
        try:
            con = sqlite3.connect("file:%s?mode=ro" % copy, uri=True)
            cur = con.cursor()
            total = cur.execute("select count(*) from cfurl_cache_response").fetchone()[0]
            oldest, newest = cur.execute(
                "select min(time_stamp), max(time_stamp) from cfurl_cache_response"
            ).fetchone()
            onetime = cur.execute(
                "select count(*) from cfurl_cache_response "
                "where request_key like '%duo-callback%' or request_key like '%SAMLResponse%' "
                "or request_key like '%code=%'"
            ).fetchone()[0]
            con.close()
            return {"total": total, "oldest": oldest, "newest": newest, "onetime": onetime}
        except sqlite3.Error:
            return None


# --------------------------------------------------------------------------
# mutation runner
# --------------------------------------------------------------------------


class Runner:
    def __init__(self, dry, backup_root):
        self.dry = dry
        self.root = backup_root
        self.manifest = []

    def _stash(self, path):
        """Copy `path` into the backup tree, preserving its location under $HOME."""
        if self.dry:
            return None
        try:
            rel = path.relative_to(HOME)
        except ValueError:
            die("cannot back up %s: it is outside %s" % (path, HOME))
        dest = self.root / "files" / rel
        dest.parent.mkdir(parents=True, exist_ok=True)
        if path.is_dir():
            shutil.copytree(path, dest, dirs_exist_ok=True, symlinks=True)
        else:
            shutil.copy2(path, dest)
            os.chmod(dest, 0o600)  # same live cookies as the original
        self.manifest.append({"kind": "file", "path": str(rel)})
        return dest

    def remove(self, path, why):
        path = Path(path)
        if not path.exists():
            return
        real = safe_target(path)
        size = dir_size(real) if real.is_dir() else real.stat().st_size
        print("  remove  %-58s %6s  %s" % (str(real).replace(str(HOME), "~"), human(size), why))
        if self.dry:
            return
        self._stash(real)
        if real.is_dir():
            shutil.rmtree(real)
        else:
            real.unlink()

    def clear_dir(self, path, why):
        path = Path(path)
        if not path.is_dir():
            return
        real = safe_target(path)
        entries = sorted(real.iterdir())
        if not entries:
            return
        size = dir_size(real)
        print("  clear   %-58s %6s  %s" % (str(real).replace(str(HOME), "~") + "/*", human(size), why))
        if self.dry:
            return
        self._stash(real)
        for entry in entries:
            if entry.is_dir() and not entry.is_symlink():
                shutil.rmtree(entry)
            else:
                entry.unlink()

    def write(self, path, data, why):
        real = safe_target(path)
        print("  rewrite %-58s %6s  %s" % (str(real).replace(str(HOME), "~"), human(len(data)), why))
        if self.dry:
            return
        self._stash(real)
        tmp = real.with_name(real.name + ".ivanti-amnesia.tmp")
        with open(tmp, "wb") as fh:
            fh.write(data)
            fh.flush()
            os.fsync(fh.fileno())
        shutil.copystat(real, tmp)
        os.replace(tmp, real)

    def prune_prefs(self, keys):
        if not keys:
            return
        print("  prefs   delete %d stale SAML-logout window key(s) from %s" % (len(keys), BUNDLE))
        if self.dry:
            return
        for key in keys:
            subprocess.run(["defaults", "delete", BUNDLE, key], capture_output=True, timeout=30)
        self.manifest.append({"kind": "prefs", "domain": BUNDLE, "deleted": keys})


