# commands
# --------------------------------------------------------------------------


def cmd_status(args):
    print("%sIvanti Secure Access - login state%s" % (BOLD, OFF))
    version = "?"
    info = APP / "Contents/Info.plist"
    if info.exists():
        try:
            version = plistlib.loads(info.read_bytes()).get("CFBundleShortVersionString", "?")
        except Exception:
            pass
    print("  app          %s  (%s)" % (version, APP if APP.exists() else "NOT INSTALLED"))

    pids = app_pids()
    if pids:
        main = pids[0]
        print("  process      running, pid %d, up %s (since %s)" % (main, pid_elapsed(main), pid_started(main)))
        print("               %sthe embedded browser's in-memory session cookies live in this process%s" % (DIM, OFF))
    else:
        print("  process      not running  %s(in-memory session cookies are already gone)%s" % (DIM, OFF))

    hosts = gateway_hosts()
    live = tunnel_established(hosts)
    print("  gateway      %s" % (", ".join(hosts) if hosts else "unknown"))
    print("  tunnel       %s" % ("CONNECTED (%s:443)" % live[0] if live else "no live session"))

    relay = private_relay_active()
    print("  iCloud Relay %s" % {True: "ON - turn it off, it breaks the OSU login", False: "off", None: "unknown"}[relay])

    print()
    print("%sPersistent web state%s" % (BOLD, OFF))
    flags = []
    if JAR.exists():
        data = JAR.read_bytes()
        ok = jar_selftest(data)
        mtime = dt.datetime.fromtimestamp(JAR.stat().st_mtime).strftime("%Y-%m-%d %H:%M")
        print("  cookie jar   %s  (%s, last written %s, round-trip %s)"
              % (JAR.name, human(len(data)), mtime, "ok" if ok else "FAILED"))
        if not ok:
            flags.append("cookie jar does not round-trip; `fix --level session` will refuse, use --level full")
        try:
            pages, _ = jar_load(data)
        except Exception as exc:
            print("               unreadable: %s" % exc)
            pages = []
        rows = []
        for recs in pages:
            for rec in recs:
                field = cookie_fields(rec)
                rows.append((field["domain"], field["name"], field, keep_cookie(field)))
        for domain, name, field, kept in sorted(rows):
            print("    %-4s %-31s %-46s %s  %s -> %s"
                  % ("keep" if kept else "%sdrop%s" % (YEL, OFF),
                     domain, name[:46], redact(field["value"]),
                     mac_time(field["created"]), mac_time(field["expires"])))
        print("               %skeep/drop shown for `fix --level session`; --level full drops all%s" % (DIM, OFF))
    else:
        print("  cookie jar   absent")

    orphans = sorted(JAR.parent.glob(BUNDLE + ".binarycookies_tmp_*.dat"))
    if orphans:
        for path in orphans:
            age = (time.time() - path.stat().st_mtime) / 86400.0
            print("  %sorphan jar%s   %s  (%s, %.0f days old)" % (YEL, OFF, path.name, human(path.stat().st_size), age))
        flags.append("%d orphaned cookie-jar temp file(s): the app was hard-killed mid-write at least once"
                     % len(orphans))

    stats = cache_stats()
    if stats:
        print("  http cache   %d responses (%s), %s .. %s"
              % (stats["total"], human(dir_size(CACHE_DIR)), stats["oldest"], stats["newest"]))
        if stats["onetime"]:
            print("               %s%d cached single-use SSO callback URL(s) (duo-callback / code=)%s"
                  % (YEL, stats["onetime"], OFF))
            flags.append("%d one-time SSO callbacks sitting in the on-disk cache" % stats["onetime"])
    elif CACHE_DIR.exists():
        print("  http cache   %s" % human(dir_size(CACHE_DIR)))

    if WEBKIT_DIR.exists():
        print("  webkit data  %s" % human(dir_size(WEBKIT_DIR)))

    stale_keys = prunable_pref_keys(prefs_export())
    if stale_keys:
        print("  prefs        %d saved SAML-logout window key(s)" % len(stale_keys))
        flags.append("%d accumulated SAML Single-Logout window keys: sign-out has been failing" % len(stale_keys))

    print()
    if flags:
        print("%sFindings%s" % (BOLD, OFF))
        for flag in flags:
            print("  - %s" % flag)
        print()
    if live:
        print("You are connected. Nothing to do - run `fix` only when a login is stuck.")
    else:
        print("If a login is stuck, run: %sivanti-amnesia fix%s   (add --dry-run to preview)" % (BOLD, OFF))
    return 0


def cmd_fix(args):
    if not APP.exists():
        die("Ivanti Secure Access is not installed at %s" % APP)

    hosts = gateway_hosts()
    live = tunnel_established(hosts)
    if live and not args.force:
        die("the VPN is currently connected (%s:443).\n"
            "       Disconnect in the Ivanti window first, then re-run.\n"
            "       Use --force to proceed anyway (this will not tear down the tunnel)." % live[0])

    stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    root = BACKUPS / stamp
    if not args.dry_run:
        root.mkdir(parents=True, exist_ok=True)
        os.chmod(BACKUPS, 0o700)
        os.chmod(root, 0o700)

    print("%sivanti-amnesia fix --level %s%s%s" % (BOLD, args.level, "  [dry run]" if args.dry_run else "", OFF))
    print("  backup  %s" % (str(root).replace(str(HOME), "~") if not args.dry_run else "(none - dry run)"))
    print()

    print("%s1. stop the app%s  (its process holds the in-memory SSO session cookies)" % (BOLD, OFF))
    if args.no_quit:
        print("  skipped (--no-quit)")
    elif not quit_app(args.dry_run):
        die("could not stop Ivanti Secure Access cleanly. Quit it from the menu bar and re-run.\n"
            "       (This tool never sends SIGKILL: a hard kill mid-flush is one cause of the bug.)")
    print()

    runner = Runner(args.dry_run, root)

    if not args.dry_run:
        prefs = prefs_export()
        if prefs:
            with open(root / "prefs.plist", "wb") as fh:
                plistlib.dump(prefs, fh)

    print("%s2. clear the stale web state%s" % (BOLD, OFF))

    if args.level == "session" and JAR.exists():
        data = JAR.read_bytes()
        if not jar_selftest(data):
            die("this cookie jar does not survive a round trip, so surgical editing is unsafe.\n"
                "       Re-run with --level full (you will need one extra Duo approval).")
        pages, meta = jar_load(data)
        kept, dropped = [], 0
        for recs in pages:
            page = []
            for rec in recs:
                if keep_cookie(cookie_fields(rec)):
                    page.append(rec)
                else:
                    dropped += 1
            kept.append(page)
        kept = [p for p in kept if p]
        if not kept:
            runner.remove(JAR, "no cookies worth keeping")
        elif dropped == 0:
            print("  keep    cookie jar unchanged (only Duo device-trust cookies present)")
        else:
            new = jar_dump(kept, meta)
            check, _ = jar_load(new)
            if sum(len(p) for p in check) != sum(len(p) for p in kept):
                die("internal check failed while rebuilding the cookie jar; nothing was changed")
            runner.write(JAR, new, "dropped %d SSO cookie(s), kept %d Duo cookie(s)"
                         % (dropped, sum(len(p) for p in kept)))
    elif JAR.exists():
        runner.remove(JAR, "all cookies incl. Duo device trust")

    for orphan in sorted(JAR.parent.glob(BUNDLE + ".binarycookies_tmp_*.dat")):
        runner.remove(orphan, "orphaned jar from an interrupted write")

    runner.clear_dir(CACHE_DIR, "cached SSO responses and one-time callback URLs")

    if args.level == "full":
        runner.clear_dir(HTTP_DIR, "alt-svc / HTTP storage")
        runner.clear_dir(WEBKIT_DIR / "WebsiteData", "WebKit local storage")

    runner.prune_prefs(prunable_pref_keys(prefs_export()))
    print()

    if not args.dry_run:
        with open(root / "manifest.json", "w") as fh:
            json.dump({"version": 1, "level": args.level, "created": stamp,
                       "items": runner.manifest}, fh, indent=2)

    print("%s3. restart%s" % (BOLD, OFF))
    if args.no_relaunch:
        print("  skipped (--no-relaunch)")
    else:
        launch_app(args.dry_run)
    print()

    if args.dry_run:
        print("Dry run - nothing was changed. Drop --dry-run to apply.")
    else:
        print("%sDone.%s Connect again; you should get a fresh login page." % (GRN, OFF))
        print("Undo with: %sivanti-amnesia restore %s%s" % (BOLD, stamp, OFF))
    return 0


def cmd_capture(args):
    stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    root = CAPTURES / stamp
    root.mkdir(parents=True, exist_ok=True)
    os.chmod(CAPTURES, 0o700)
    os.chmod(root, 0o700)

    for src in (JAR, PREFS):
        if src.exists():
            shutil.copy2(src, root / src.name)
    for orphan in sorted(JAR.parent.glob(BUNDLE + ".binarycookies_tmp_*.dat")):
        shutil.copy2(orphan, root / orphan.name)
    for suffix in ("", "-wal", "-shm"):
        src = Path(str(CACHE_DIR / "Cache.db") + suffix)
        if src.exists():
            shutil.copy2(src, root / src.name)

    try:
        logs = subprocess.run(
            ["log", "show", "--style", "compact", "--last", args.since,
             "--predicate",
             'process CONTAINS "Pulse" OR process CONTAINS "Ivanti" OR process == "WebLoginService"'],
            capture_output=True, text=True, timeout=180,
        ).stdout
        (root / "unified-log.txt").write_text(logs)
    except (OSError, subprocess.SubprocessError) as exc:
        (root / "unified-log.txt").write_text("log capture failed: %s\n" % exc)

    os.chmod(root, 0o700)
    for item in root.iterdir():
        if item.is_file():
            os.chmod(item, 0o600)

    # The warning travels with the bundle: whoever opens a copy of this directory
    # should see it even if they never saw the terminal output.
    (root / "READ-ME-FIRST.txt").write_text(CAPTURE_WARNING % shell_quote(root))
    os.chmod(root / "READ-ME-FIRST.txt", 0o600)

    print("Captured to %s" % str(root).replace(str(HOME), "~"))
    print()
    print("%s%s%s" % (YEL, (CAPTURE_WARNING % shell_quote(root)).strip(), OFF))
    return 0


def cmd_backups(args):
    if not BACKUPS.is_dir():
        print("no backups yet")
        return 0
    entries = sorted(p for p in BACKUPS.iterdir() if p.is_dir())
    if not entries:
        print("no backups yet")
        return 0
    for path in entries:
        level = "?"
        manifest = path / "manifest.json"
        if manifest.exists():
            try:
                level = json.loads(manifest.read_text()).get("level", "?")
            except ValueError:
                pass
        print("  %s  level=%-8s %6s  %s" % (path.name, level, human(dir_size(path)), path))
    return 0


def cmd_restore(args):
    if not BACKUPS.is_dir():
        die("no backups exist")
    entries = sorted(p for p in BACKUPS.iterdir() if p.is_dir())
    if not entries:
        die("no backups exist")
    if args.stamp in ("latest", "last"):
        root = entries[-1]
    else:
        root = BACKUPS / args.stamp
        if not root.is_dir():
            die("no such backup: %s (try `ivanti-amnesia backups`)" % args.stamp)

    if app_pids():
        die("quit Ivanti Secure Access first, then re-run")

    print("%srestoring %s%s" % (BOLD, root.name, OFF))
    files_root = root / "files"
    if files_root.is_dir():
        for src in sorted(files_root.rglob("*")):
            if src.is_dir():
                continue
            dest = HOME / src.relative_to(files_root)
            safe_target(dest)
            print("  restore %s" % str(dest).replace(str(HOME), "~"))
            if not args.dry_run:
                dest.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(src, dest)
    prefs_backup = root / "prefs.plist"
    if prefs_backup.exists():
        print("  restore preferences for %s" % BUNDLE)
        if not args.dry_run:
            subprocess.run(["defaults", "import", BUNDLE, str(prefs_backup)],
                           capture_output=True, timeout=30)
    print()
    print("Dry run - nothing changed." if args.dry_run else "%sRestored.%s" % (GRN, OFF))
    return 0


def cmd_selftest(args):
    """Verify the codec against whatever jars exist on this machine."""
    targets = [JAR] + sorted(JAR.parent.glob(BUNDLE + ".binarycookies_tmp_*.dat"))
    targets += sorted((CAPTURES).rglob("*.binarycookies*")) if CAPTURES.is_dir() else []
    found = 0
    failed = 0
    for path in targets:
        if not path.exists():
            continue
        found += 1
        data = path.read_bytes()
        ok = jar_selftest(data)
        failed += 0 if ok else 1
        print("  %-6s %s (%s)" % ("ok" if ok else "FAIL", path.name, human(len(data))))
    if not found:
        print("  no cookie jars on this machine to test against")
        return 0
    print("%d/%d round-tripped byte-for-byte" % (found - failed, found))
    return 1 if failed else 0


def main():
    parser = argparse.ArgumentParser(
        prog="ivanti-amnesia",
        description="Diagnose and recover a stuck Ivanti Secure Access SAML login.",
    )
    sub = parser.add_subparsers(dest="cmd")

    p = sub.add_parser("status", help="read-only report on the current login state")
    p.set_defaults(func=cmd_status)

    p = sub.add_parser("fix", help="clear the stale SSO state and restart the app")
    p.add_argument("--level", choices=("session", "full"), default="session",
                   help="session (default): drop SSO cookies, keep Duo device trust. "
                        "full: drop everything, costs one extra Duo approval")
    p.add_argument("--dry-run", action="store_true", help="print the plan, change nothing")
    p.add_argument("--force", action="store_true", help="run even while the VPN is connected")
    p.add_argument("--no-quit", action="store_true", help="do not stop the app first")
    p.add_argument("--no-relaunch", action="store_true", help="do not reopen the app afterwards")
    p.set_defaults(func=cmd_fix)

    p = sub.add_parser("capture",
                       help="snapshot state + logs while the failure is on screen "
                            "(WARNING: writes unredacted live cookies to disk)")
    p.add_argument("--since", default="30m", help="how far back to pull the unified log (default 30m)")
    p.set_defaults(func=cmd_capture)

    p = sub.add_parser("backups", help="list backups taken by `fix`")
    p.set_defaults(func=cmd_backups)

    p = sub.add_parser("restore", help="undo a `fix` from its backup")
    p.add_argument("stamp", nargs="?", default="latest", help="backup id, or 'latest'")
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(func=cmd_restore)

    p = sub.add_parser("selftest", help="verify the cookie-jar codec round-trips")
    p.set_defaults(func=cmd_selftest)

    args = parser.parse_args()
    if not getattr(args, "func", None):
        args = parser.parse_args(["status"])

    if sys.platform != "darwin":
        die("macOS only")
    if os.geteuid() == 0:
        die("refusing to run as root - this only touches your own ~/Library")

    return args.func(args)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
